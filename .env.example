DATABASE_URL="file:./dev.db"

# Gate do operador — as telas internas (/atendente, /dashboard) exigem login, e cada
# operador só vê a própria empresa. No MVP há um operador por empresa demo (username =
# slug do tenant: dgc, assistencia-tecnica-demo, prestacon), criado automaticamente na
# primeira visita ao /login com a senha abaixo. Troque em produção.
OPERATOR_SEED_PASSWORD="troque-esta-senha"
# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# Cérebro do atendente (fase 2). Providers: mock | claude_cli
# - mock: respostas determinísticas, sem IA (default, para testar o fluxo)
# - claude_cli: IA real via Claude CLI logado na máquina (modo headless, sem ferramentas)
ATTENDANT_PROVIDER="mock"

# Modelo usado pelo provider claude_cli (sonnet recomendado; opus é mais lento)
CLAUDE_MODEL="sonnet"

# Timeout (ms) para a resposta do atendente antes de cair em handoff seguro
ATTENDANT_TIMEOUT_MS="30000"

# Transcrição de áudio (fase 2.5) — faster-whisper local via venv isolado.
# Rode `bash scripts/setup-transcribe.sh` uma vez para criar o venv.
WHISPER_MODEL="base"            # tiny | base | small ... (base = bom equilíbrio no Pi)
TRANSCRIBE_PYTHON=".venv-transcribe/bin/python"
TRANSCRIBE_SCRIPT="scripts/transcribe.py"
TRANSCRIBE_TIMEOUT_MS="120000"  # load do modelo + decodificação no Pi

# Diagnóstico: ATTENDANT_DEBUG=1 loga conteúdo cru (resposta da IA / texto transcrito).
# Contém PII do cliente — use só para depurar, nunca em produção.
ATTENDANT_DEBUG=""

# Alarme de degradação: se o cérebro CAIR no fallback (provider/validação), avisa você
# em vez de degradar em silêncio. Sempre loga um [ALARM]; se a URL abaixo estiver
# definida, também faz um POST (texto puro). Mais fácil: ntfy.sh (push no celular, sem
# conta) — instale o app ntfy, assine um tópico secreto e use a URL dele.
ALARM_WEBHOOK_URL=""            # ex.: https://ntfy.sh/hermes-dgc-<algo-secreto>
ALARM_COOLDOWN_MS="600000"     # 10 min: 1 alarme por janela, contando os suprimidos

# WhatsApp oficial (Meta Cloud API). Tudo vazio = canal DESLIGADO (só o simulador roda).
# Passo a passo do setup na Meta: docs/whatsapp-setup.md. Nunca commitar valores reais.
WHATSAPP_VERIFY_TOKEN=""    # você inventa uma string; o MESMO valor vai no painel da Meta
WHATSAPP_APP_SECRET=""      # App Secret do app na Meta — valida a assinatura do webhook
WHATSAPP_ACCESS_TOKEN=""    # token de acesso da Cloud API (do número de teste/produção)
WHATSAPP_PHONE_NUMBER_ID="" # ID do número que envia/recebe
WHATSAPP_NUMBER_MAP=""      # número -> empresa: "phoneId:slug" (ex.: "123456:assistencia-tecnica-demo")
