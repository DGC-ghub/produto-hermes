# Em produção use caminho ABSOLUTO (o serviço pode rodar de outro cwd e criar um
# banco-fantasma vazio): ex. "file:/home/pi/projects/produto-hermes/dev.db"
DATABASE_URL="file:./dev.db"

# Gate do operador — as telas internas (/atendente, /dashboard) exigem login, e cada
# operador só vê a própria empresa. A senha seed vale SÓ para os tenants de demo
# (dgc, assistencia-tecnica-demo); cliente real recebe credencial própria via
# `npm run operator:add -- <tenant> <username>`. Obrigatória em produção (fail-closed).
OPERATOR_SEED_PASSWORD="troque-esta-senha"
# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# E-mail transacional (Resend) — confirmação de cadastro no /signup. Vazio = modo LOG
# (não envia, só registra); seguro pra dev. Guia p/ ligar: docs/resend-setup.md
RESEND_API_KEY=""           # começa com re_ — pegue em resend.com → API Keys
EMAIL_FROM="Hermes <onboarding@resend.dev>"  # sem domínio verificado, só entrega pro dono da conta

# Cérebro do atendente (fase 2). Providers: mock | claude_cli | anthropic_api
# - mock: respostas determinísticas, sem IA (default, para testar o fluxo)
# - claude_cli: IA real via Claude CLI logado na máquina (assinatura pessoal do dono;
#   sem custo por token, mas depende do CLI logado nesta máquina)
# - anthropic_api: IA real via API da Anthropic (o CLIENTE paga os tokens que usa via
#   ANTHROPIC_API_KEY). As duas versões montam o MESMO prompt → saída comparável.
ATTENDANT_PROVIDER="mock"

# Modelo usado pelo provider claude_cli (sonnet recomendado; opus é mais lento)
CLAUDE_MODEL="sonnet"

# ── Motor via API da Anthropic (provider anthropic_api) ──────────────────────
# Chave da API — pegue em console.anthropic.com → API Keys. Começa com sk-ant-.
# Obrigatória quando ATTENDANT_PROVIDER=anthropic_api (sem ela, cai em handoff seguro).
ANTHROPIC_API_KEY=""
# Modelo cobrado por token. Default claude-opus-4-8 (mais capaz); baixe para
# claude-sonnet-5 ou claude-haiku-4-5 conforme a economia de cada cliente.
ANTHROPIC_MODEL="claude-opus-4-8"
# Teto de tokens da resposta (o JSON do atendente cabe folgado em 1024).
ANTHROPIC_MAX_TOKENS="1024"

# Timeout (ms) para a resposta do atendente antes de cair em handoff seguro. Mantenha
# ACIMA do pior caso medido no eval (ver npm run eval:motor) — abaixo disso, uma
# resposta lenta legítima vira fallback falso. Medido ~30,7s no claude_cli/Pi → 45000.
ATTENDANT_TIMEOUT_MS="45000"

# Transcrição de áudio (fase 2.5) — faster-whisper local via venv isolado.
# Rode `bash scripts/setup-transcribe.sh` uma vez para criar o venv.
WHISPER_MODEL="base"            # tiny | base | small ... (base = bom equilíbrio no Pi)
TRANSCRIBE_PYTHON=".venv-transcribe/bin/python"
TRANSCRIBE_SCRIPT="scripts/transcribe.py"
TRANSCRIBE_TIMEOUT_MS="120000"  # load do modelo + decodificação no Pi

# Diagnóstico: ATTENDANT_DEBUG=1 loga conteúdo cru (resposta da IA / texto transcrito).
# Contém PII do cliente — use só para depurar, nunca em produção.
ATTENDANT_DEBUG=""

# Alarme de degradação: se o cérebro CAIR no fallback (provider/validação), avisa você
# em vez de degradar em silêncio. Sempre loga um [ALARM]; se a URL abaixo estiver
# definida, também faz um POST (texto puro). Mais fácil: ntfy.sh (push no celular, sem
# conta) — instale o app ntfy, assine um tópico secreto e use a URL dele.
ALARM_WEBHOOK_URL=""            # ex.: https://ntfy.sh/hermes-dgc-<algo-secreto>
ALARM_COOLDOWN_MS="600000"     # 10 min: 1 alarme por janela, contando os suprimidos

# Limite de taxa do webhook público (anti-flood). Teto GLOBAL por janela — o excesso
# leva 429 antes de gastar CPU. Defaults generosos (uso de piloto é bem menor).
RATE_LIMIT_MAX="120"           # requisições por janela
RATE_LIMIT_WINDOW_MS="60000"   # tamanho da janela (1 min)

# WhatsApp oficial (Meta Cloud API). Tudo vazio = canal DESLIGADO (só o simulador roda).
# Passo a passo do setup na Meta: docs/whatsapp-setup.md. Nunca commitar valores reais.
WHATSAPP_VERIFY_TOKEN=""    # você inventa uma string; o MESMO valor vai no painel da Meta
WHATSAPP_APP_SECRET=""      # App Secret do app na Meta — valida a assinatura do webhook
WHATSAPP_ACCESS_TOKEN=""    # token de acesso da Cloud API (do número de teste/produção)
WHATSAPP_PHONE_NUMBER_ID="" # ID do número que envia/recebe
WHATSAPP_NUMBER_MAP=""      # número -> empresa: "phoneId:slug" (ex.: "123456:assistencia-tecnica-demo")

# ── Canal WhatsApp por QR (não-oficial / Baileys — self-service) ─────────────
# "1" liga o canal por QR: o dono conecta o WhatsApp da empresa escaneando um QR na
# tela /canais (sem o processo da Meta). Vazio/ausente = DESLIGADO (protege os
# pilotos oficiais; o boot não sobe socket nem carrega a lib Baileys). ⚠️ Canal
# não-oficial pode ser banido pela Meta — não usar em base de saúde crítica; pra
# esses, o WhatsApp oficial acima. Ligar é decisão de rollout do dono.
BAILEYS_ENABLED=""

# ── Mercado Pago (cobrança — marco M3) ──────────────────────────────────────
# Token da API do MP (produção) — cria/lê a assinatura (preapproval). Vazio = modo
# stub (não cobra, não move dinheiro). Pegue no painel do MP → Credenciais.
MP_ACCESS_TOKEN=""
# Chave SECRETA de assinatura do webhook (painel do MP → Webhooks → "Assinatura
# secreta"). Valida o header x-signature das notificações (issue #6). Vazio = o webhook
# REJEITA tudo (fail-closed) — configure antes de depender das notificações do MP.
MP_WEBHOOK_SECRET=""

# ── Gate de cobrança (Tier 2) ───────────────────────────────────────────────
# "1" liga o BLOQUEIO do atendimento quando a assinatura do tenant não está ativa.
# Tenant SEM assinatura (piloto/legado) NUNCA é bloqueado (grandfathering). Vazio/
# ausente = gate DESLIGADO (construído, mas não bloqueia). Ligue só depois de decidir
# o grandfathering. Ver app/lib/billing-gate.server.ts.
BILLING_GATE_ENABLED=""
