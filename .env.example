DATABASE_URL="file:./dev.db"

# Cérebro do atendente (fase 2). Providers: mock | claude_cli
# - mock: respostas determinísticas, sem IA (default, para testar o fluxo)
# - claude_cli: IA real via Claude CLI logado na máquina (modo headless, sem ferramentas)
ATTENDANT_PROVIDER="mock"

# Modelo usado pelo provider claude_cli (sonnet recomendado; opus é mais lento)
CLAUDE_MODEL="sonnet"

# Timeout (ms) para a resposta do atendente antes de cair em handoff seguro
ATTENDANT_TIMEOUT_MS="30000"

# Transcrição de áudio (fase 2.5) — faster-whisper local via venv isolado.
# Rode `bash scripts/setup-transcribe.sh` uma vez para criar o venv.
WHISPER_MODEL="base"            # tiny | base | small ... (base = bom equilíbrio no Pi)
TRANSCRIBE_PYTHON=".venv-transcribe/bin/python"
TRANSCRIBE_SCRIPT="scripts/transcribe.py"
TRANSCRIBE_TIMEOUT_MS="120000"  # load do modelo + decodificação no Pi

# Diagnóstico: ATTENDANT_DEBUG=1 loga conteúdo cru (resposta da IA / texto transcrito).
# Contém PII do cliente — use só para depurar, nunca em produção.
ATTENDANT_DEBUG=""
