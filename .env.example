DATABASE_URL="file:./dev.db"

# Só no BUILD, e só atrás de proxy HTTPS (lista separada por vírgula). Vazio = padrão seguro.
# HERMES_ALLOWED_ACTION_ORIGINS="app.exemplo.com"

# M7 nota automática (demo, SÓ sandbox). Sem valor = a demo usa o emissor falso.
ASAAS_API_KEY=
# Deve conter "sandbox" (ex.: o endereço do sandbox na doc do Asaas). Outro endereço é recusado.
ASAAS_BASE_URL=
# Token do webhook (cabeçalho asaas-access-token). Sem ele, o webhook recusa tudo.
ASAAS_WEBHOOK_TOKEN=
