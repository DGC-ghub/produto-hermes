[Unit]
Description=Expurgo LGPD do Hermes piloto (apaga conversas alem do prazo de cada empresa: 90 dias, e 7 para dgc e assistencia-tecnica-demo)

[Service]
Type=oneshot
WorkingDirectory=%h/hermes-piloto/current
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LGPD_LOG=%h/hermes-piloto/data/lgpd-apagados.jsonl
ExecStart=%h/hermes-piloto/current/node_modules/.bin/tsx scripts/lgpd.ts retencao --confirmar
MemoryMax=400M
