{
  "name": "produto-hermes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "eval:motor": "vitest run --config vitest.eval.config.ts",
    "eval:gate": "npx tsx scripts/eval-gate.ts",
    "eval:baseline": "npx tsx scripts/eval-gate.ts --promover",
    "metrics": "npx tsx scripts/metrics-report.ts",
    "operator:add": "npx tsx scripts/operator-add.ts",
    "tenant:add": "npx tsx scripts/tenant-add.ts",
    "prova:chamado": "npx tsx scripts/prova-chamado.ts",
    "prova:signup": "npx tsx scripts/prova-signup.ts",
    "prova:whatsapp": "npx tsx scripts/prova-whatsapp-credential.ts",
    "setup:backfill": "npx tsx scripts/setup-backfill.ts",
    "setup:processar": "npx tsx scripts/setup-processar.ts",
    "setup:revisar": "npx tsx scripts/setup-revisar.ts",
    "email:test": "npx tsx scripts/send-test-email.ts",
    "mp:test": "npx tsx scripts/mp-test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-router/express": "8.0.0",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "isbot": "^5.1.36",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.9"
  }
}
