// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations   Conversation[]
  leads           Lead[]
  tickets         Ticket[]
  operators       Operator[]
  whatsappNumbers WhatsappNumber[]
}

// Número do WhatsApp Business (phone_number_id da Meta) que pertence a UMA empresa.
// É por aqui que o webhook resolve o tenant de uma mensagem recebida — vindo do
// BANCO, não de env, para adicionar um cliente sem redeploy. Ver plano 1.1.
model WhatsappNumber {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique
  tenantId      String
  label         String? // ajuda o operador a saber de qual número se trata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Operador (atendente humano) de UMA empresa. O login identifica o operador e a
// sessão carrega o tenant dele — toda leitura de fila/dossiê/painel é escopada por
// esse tenant, garantindo que uma empresa nunca veja os dados de outra.
model Operator {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Conversation {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String   @default("simulator")
  contactId String
  status    String   @default("open") // open | needs_human | closed
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  messages      Message[]
  lead          Lead?
  handoffEvents HandoffEvent[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  confidence     Float?
  sourcesJson    String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String?  @unique
  name           String?
  phone          String?
  neighborhood   String?
  need           String?
  urgency        String?
  stage          String   @default("novo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
}

model HandoffEvent {
  id             String   @id @default(cuid())
  conversationId String
  reason         String
  message        String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

// Chamado aberto por um contato. O isolamento de privacidade é por (tenantId, contactId):
// o balcão só lê/escreve chamados do próprio contato; o LLM nunca vê os de outros.
model Ticket {
  id          String   @id @default(cuid())
  tenantId    String
  contactId   String
  subject     String
  description String
  category    String?
  status      String   @default("aberto") // aberto | em_andamento | resolvido
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, contactId])
}

// Evento recebido do webhook do WhatsApp, persistido ANTES do 200 pra Meta:
// restart no meio do processamento não perde mensagem (a fila retoma), e o
// @unique no messageId (wamid) mata resposta duplicada em redelivery.
model WebhookEvent {
  id            String    @id @default(cuid())
  messageId     String    @unique // wamid da Meta — dedup de redelivery
  phoneNumberId String // número da empresa que recebeu → resolve o tenant
  contactId     String // wa_id do remetente
  text          String
  status        String    @default("pending") // pending | done | failed
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
}
