// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations   Conversation[]
  leads           Lead[]
  tickets         Ticket[]
  operators       Operator[]
  whatsappNumbers WhatsappNumber[]
  channelSessions ChannelSession[]
  memberships     Membership[]
  configRecord    TenantConfigRecord?
  knowledgeDocs   KnowledgeDoc[]
  subscription    Subscription?
  messageTraces   MessageTrace[]
}

// Número do WhatsApp Business (phone_number_id da Meta) que pertence a UMA empresa.
// É por aqui que o webhook resolve o tenant de uma mensagem recebida — vindo do
// BANCO, não de env, para adicionar um cliente sem redeploy. Ver plano 1.1.
model WhatsappNumber {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique
  tenantId      String
  label         String? // ajuda o operador a saber de qual número se trata
  // Credenciais PRÓPRIAS do tenant, cifradas em repouso (crypto.server, AAD `tenant:<id>`).
  // Null = usa o env global (fallback de transição — estratégia C, igual ao config/knowledge).
  accessTokenEnc String? // token de envio da Cloud API deste número (cifrado)
  appSecretEnc   String? // App Secret p/ validar a assinatura do webhook deste número (cifrado)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Sessão de canal NÃO-oficial (Baileys/QR) de UMA empresa — self-service: o cliente
// escaneia um QR e conecta o próprio WhatsApp em minutos (sem o processo da Meta).
// O socket é persistente e vive no processo (ver plano vendável v1 §1.4). O
// auth-state do Baileys fica CIFRADO aqui (crypto.server, AAD `channel-session:<id>`),
// pra reconectar sem re-escanear. Vários por tenant (ex.: números diferentes).
model ChannelSession {
  id           String    @id @default(cuid())
  tenantId     String
  kind         String    @default("baileys") // canal; hoje só baileys
  label        String? // ex.: "WhatsApp da recepção"
  waNumber     String? // número conectado (preenchido após parear) — exibição
  status       String    @default("desconectado") // desconectado|pareando|conectado|derrubado
  authStateEnc String? // auth-state do Baileys CIFRADO (creds+keys), null = ainda não pareou
  lastConnAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

// Operador (atendente humano) de UMA empresa. O login identifica o operador e a
// sessão carrega o tenant dele — toda leitura de fila/dossiê/painel é escopada por
// esse tenant, garantindo que uma empresa nunca veja os dados de outra.
model Operator {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Conversation {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String   @default("simulator")
  contactId String
  status    String   @default("open") // open | needs_human | closed
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  messages      Message[]
  lead          Lead?
  handoffEvents HandoffEvent[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  confidence     Float?
  sourcesJson    String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String?  @unique
  name           String?
  phone          String?
  neighborhood   String?
  need           String?
  urgency        String?
  stage          String   @default("novo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
}

model HandoffEvent {
  id             String   @id @default(cuid())
  conversationId String
  reason         String
  message        String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

// Chamado aberto por um contato. O isolamento de privacidade é por (tenantId, contactId):
// o balcão só lê/escreve chamados do próprio contato; o LLM nunca vê os de outros.
model Ticket {
  id          String   @id @default(cuid())
  tenantId    String
  contactId   String
  subject     String
  description String
  category    String?
  status      String   @default("aberto") // aberto | em_andamento | resolvido
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, contactId])
}

// Evento recebido do webhook do WhatsApp, persistido ANTES do 200 pra Meta:
// restart no meio do processamento não perde mensagem (a fila retoma), e o
// @unique no messageId (wamid) mata resposta duplicada em redelivery.
model WebhookEvent {
  id            String    @id @default(cuid())
  // Meta: wamid (globalmente único). Baileys: `b:<channelSessionId>:<key.id>` — o
  // prefixo escopa o dedup por sessão (o key.id do Baileys não é único global).
  messageId     String    @unique
  phoneNumberId String // Meta: número que recebeu → resolve o tenant. Baileys: vazio.
  // Baileys: a sessão que recebeu → resolve o tenant (e distingue a origem do evento).
  // Null = evento da Meta (usa phoneNumberId). Aditivo (não mexe nos eventos Meta).
  channelSessionId String?
  contactId     String // wa_id (Meta) / MSISDN (Baileys) do remetente
  // Baileys: o jid ORIGINAL de entrada (`<lid>@lid` ou `<phone>@s.whatsapp.net`). O
  // WhatsApp novo endereça por @lid (número oculto) — responder aos dígitos vai pro
  // vácuo. Guardado pra o operador humano e pendências pós-restart responderem ao jid
  // certo. Null = evento Meta (usa contactId como wa_id).
  remoteJid     String?
  text          String
  kind          String    @default("text") // text (roda o motor) | unsupported (cortesia)
  status        String    @default("pending") // pending | processing | done | failed
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  claimedAt     DateTime? // quando um drain reivindicou a linha (requeue de órfão)
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([channelSessionId])
}

// Conta de LOGIN — a pessoa que acessa o Hermes (dono pagante ou atendente). Separada
// do Tenant: uma conta pode ter papel em mais de uma empresa (via Membership). O signup
// self-service (marco M2) cria uma Account nova; o billing (M3) liga a assinatura aqui.
model Account {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  legacyUsername  String?   @unique // login antigo por username=slug (operadores migrados)
  emailVerifiedAt DateTime? //          marco M2 (verificação de e-mail); null = não verificado
  emailVerifyToken     String?   @unique // token do link de confirmação por e-mail (M2.6)
  emailVerifyExpiresAt DateTime? //         validade do token de confirmação
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
}

// Liga uma Account a um Tenant COM um papel. "owner" administra (config, billing);
// "operator" só atende. Uma conta = no máximo um vínculo por tenant.
model Membership {
  id        String   @id @default(cuid())
  accountId String
  tenantId  String
  role      String   @default("operator") // "owner" | "operator"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([accountId, tenantId])
  @@index([tenantId])
}

// Config do tenant no BANCO (marco M2) — hoje a fonte é config/tenants/<slug>.json.
// Guardamos o JSON já validado (parseTenantConfig segue sendo a validação); tirar do
// arquivo é o que destrava o provisionamento self-service (um signup HTTP não escreve
// arquivo no host). Um registro por tenant.
model TenantConfigRecord {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  json      String // TenantConfig serializado (sem o slug, igual ao arquivo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Assinatura do tenant (marco M3) — agnóstica de gateway: os campos provider* servem pra Stripe,
// Mercado Pago, Asaas ou Pix manual. O webhook do gateway escolhido sincroniza status/período.
// Um registro por tenant. O "S" de SaaS pago mora aqui.
model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  provider           String    @default("none") // none | stripe | mercadopago | asaas | manual
  providerCustomerId String? //                    id do cliente no gateway
  providerSubId      String?   @unique //           id da assinatura no gateway (dedup de webhook)
  status             String    @default("trialing") // trialing | active | past_due | canceled
  planId             String? //                       referência ao catálogo em código (PLANS)
  currentPeriodEnd   DateTime? //                     fim do período pago/trial
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Documento de conhecimento do tenant no BANCO (marco M2) — hoje espelha knowledge/<slug>/*.md.
// O dono edita pela tela em vez de subir arquivo.
model KnowledgeDoc {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Medição de UMA mensagem processada pelo motor — uma linha por mensagem, com o
// tempo de cada etapa em `stepsJson` (padrão "canonical log line": um evento largo
// em vez de N linhas por span, que no SQLite do Pi custaria 10x mais escrita).
// É a régua para responder "onde foram os 20 segundos?" e para provar que uma
// otimização funcionou — sem isso, só temos a média, que esconde a cauda.
// Sem PII: nada de conteúdo de mensagem aqui, só tempos e rótulos.
model MessageTrace {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String? //                     só para cruzar com a conversa ao investigar
  channel        String   @default("simulator") // simulator | whatsapp
  provider       String   @default("nenhum") //   mock | claude_cli | anthropic_api | nenhum
  outcome        String //                        ok | fallback | guard_handoff | billing_blocked | human_handling | erro
  totalMs        Float //                         ponta a ponta
  brainMs        Float? //                        desnormalizado: é o gargalo, merece query barata
  stepsJson      String //                        {"brain":20500,"retrieval":40,...}
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId, createdAt])
}
